<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- 00. Force HTTPS (มาตรฐานเว็บไซต์ภาครัฐ 3.0 ข้อ 9.1 / แนวปฏิบัติ สกมช.) -->
                <rule name="Redirect to HTTPS" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTPS}" pattern="^OFF$" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" redirectType="Permanent" appendQueryString="false" />
                </rule>

                <!-- 0. Security: Block direct access to sensitive directories and config files -->
                <rule name="Block Sensitive Files and Folders" stopProcessing="true">
                    <match url="^(app|bootstrap|config|database|resources|routes|tests|scratch|nodejs|sso/config\.php|composer\.|package|phpunit|vite\.config|\.git|\.env|artisan|php_cli\.ini)" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access Denied" />
                </rule>

                <!-- 1. Rule for V5 root (empty URL/homepage request): rewrite directly to public/index.php -->
                <rule name="V5 Root Rewrite" stopProcessing="true">
                    <match url="^$" />
                    <action type="Rewrite" url="public/index.php" />
                </rule>

                <!-- 2. Rule for static files: Rewrite requests starting with build, storage, vendor, etc. to the public folder -->
                <rule name="Static Assets" stopProcessing="true">
                    <match url="^(build|storage|vendor|v4|favicon\.ico|favicon\.png|robots\.txt|sitemap\.xml|llms\.txt|LineOAMedsci\.jpg)(.*)$" />
                    <action type="Rewrite" url="public/{R:0}" />
                </rule>

                <!-- 3. Rule for Laravel routes: Rewrite all other non-existing URLs to public/index.php -->
                <rule name="Laravel MedSci V5" stopProcessing="true">
                    <match url="^(.*)$" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="public/index.php" />
                </rule>
            </rules>
        </rewrite>
        <defaultDocument>
            <files>
                <clear />
                <add value="public/index.php" />
            </files>
        </defaultDocument>
        <staticContent>
            <remove fileExtension=".xml" />
            <mimeMap fileExtension=".xml" mimeType="application/xml; charset=UTF-8" />
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <remove fileExtension=".woff" />
            <mimeMap fileExtension=".woff" mimeType="font/woff" />
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
        </staticContent>
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />

        <!-- HTTP security headers (Mozilla Web Security Cheat Sheet / NCSA Website Security Guideline) -->
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <remove name="Strict-Transport-Security" />
                <add name="Strict-Transport-Security" value="max-age=31536000" />
                <remove name="X-Content-Type-Options" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <remove name="X-Frame-Options" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <remove name="Referrer-Policy" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <remove name="Permissions-Policy" />
                <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=()" />
                <!-- Conservative CSP: blocks framing by other sites, plugins and <base> hijacking without touching script sources -->
                <remove name="Content-Security-Policy" />
                <add name="Content-Security-Policy" value="frame-ancestors 'self'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests" />
            </customHeaders>
        </httpProtocol>

        <!-- Hide "Server: Microsoft-IIS/10.0". Requires IIS 10 version 1709+ (Windows Server 2019 / 2016 with updates).
             Enable only after confirming the server supports it, otherwise IIS returns HTTP 500.19:
        <security>
            <requestFiltering removeServerHeader="true" />
        </security>
        -->
    </system.webServer>
</configuration>
<!-- config reload: 2026-07-01 -->
